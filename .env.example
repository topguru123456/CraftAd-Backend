# =============================================================================
# Craftad API — environment variables
#
# Copy this file to `.env` for local dev. In Cloud Run, set the same keys in
# Secret Manager / environment variables (NEVER commit secrets to git).
#
# Every variable here is validated at boot via src/config/env.schema.ts.
# Missing or malformed values fail-fast with a clear error message rather
# than silently breaking a downstream request.
# =============================================================================

# --- Runtime ---
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# --- Supabase ---
# Project URL — Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=

# Service role key — Supabase Dashboard → Project Settings → API → service_role
# Used for admin operations that bypass RLS (creating users mirror rows etc.)
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret — Supabase Dashboard → Project Settings → API → JWT Secret
# Used to verify the HS256 JWTs the frontend gets from supabase.auth.
SUPABASE_JWT_SECRET=

# --- Database ---
# Two URLs by Supabase + Prisma convention. Both from Supabase Dashboard →
# Project Settings → Database → Connection string.
#
# DATABASE_URL — POOLED (PgBouncer, port 6543, "Transaction" mode).
#                Used at runtime by Prisma for every query. PgBouncer
#                keeps connection counts bounded; Cloud Run instances
#                share the pool safely.
# DIRECT_URL   — DIRECT (port 5432, "Session" mode). Used ONLY by
#                `prisma migrate` and `prisma db push`. DDL operations
#                need session-level features the transaction pool
#                doesn't expose.
#
# Examples (replace {ref} and {password}):
#   DATABASE_URL=postgresql://postgres.{ref}:{password}@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
#   DIRECT_URL=postgresql://postgres.{ref}:{password}@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
DIRECT_URL=

# --- AI providers (centralized — no more "set this in every edge fn") ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# Context.dev — used by POST /brands/fetch to look up brand profiles by domain.
# Get from your context.dev dashboard. Format: brand__xxxxxxxxxxxx (no "Bearer " prefix).
CONTEXT_DEV_API_KEY=

# Pexels — used by POST /images/pexels/search and POST /images/pexels/import.
# Get from https://www.pexels.com/api/ (raw key, no "Bearer " prefix).
PEXELS_API_KEY=

# --- GCF image dispatchers (the URLs are stable; the secret is the bearer) ---
API_SECRET=
GENERATE_DISPATCHER_URL=https://generate-image-dispatcher-913804248295.us-central1.run.app
EDIT_DISPATCHER_URL=https://edit-image-dispatch-913804248295.us-central1.run.app
WEBHOOK_SECRET=
# Typography specimen for GCF `images.font` (required for image generation).
FONT_REFERENCE_URL=
# STRIPE_SECRET_KEY here MUST match Supabase Edge Function secret
# `STRIPE_SECRET_KEY` (create-setup-intent) so onboarding cards land on
# the same Stripe Customer the backend bills.

# Public URL of THIS backend — Tranzila notify_url + iframe return proxy.
# Dev:  run `ngrok http 3001` and paste the https URL here.
BACKEND_PUBLIC_URL=

# Where the user's browser opens the frontend (iframe return redirect target).
# Prod: your Vercel URL (https://your-app.vercel.app)
APP_PUBLIC_URL=

# --- CORS ---
# Comma-separated list of allowed origins for the API. Include your Vercel
# preview/prod URL (https://…) plus http://localhost:3000 for local dev.
CORS_ORIGINS=http://localhost:3000

# --- Tranzila billing (classic iframe + token renewals) ---
#
# Migration in flight from Stripe to Tranzila. See docs/billing-tranzila.md
# for the full wire contract. BILLING_PROVIDER routes /billing/* through one
# stack or the other; defaults to 'stripe' until cutover.
#
# Two terminals provisioned by the merchant:
#   fxpdply123     — iframe terminal (card capture, Apple Pay, Google Pay)
#                     + server-side token charges (same terminal per Tranzila doc)
# API keys (server-only) for POST api.tranzila.com/v1/transaction/credit_card/create
BILLING_PROVIDER=stripe
TRANZILA_TERMINAL_CHARGE=
TRANZILA_PUBLIC_KEY=
TRANZILA_PRIVATE_KEY=
# Legacy optional — not used when API keys are set
TRANZILA_TERMINAL_TOKEN=
TRANZILA_PW_CHARGE=
TRANZILA_PW_TOKEN=
TRANZILA_ADMIN_SECRET=

# --- DEV BYPASS (REMOVE BEFORE PROD) ---
# Set to true to enable POST /billing/tranzila/bypass-trial which lets
# authenticated users skip the real Tranzila iframe during internal
# testing. NEVER set to true in production — disables real payment
# verification entirely. Pair with VITE_TRANZILA_BYPASS_ENABLED on the
# frontend to expose the bypass button in /trial.
TRANZILA_BYPASS_ENABLED=false

# --- PAYMENT TEST MODE (REMOVE BEFORE PROD) ---
# Set to true to charge ₪1 on every renewal regardless of the plan's
# real price. Lets you verify the full payment pipeline (signup →
# trial → renewal → plan switch → cancel + retention discount) with
# real Tranzila transactions at a token cost. Trial J5 verify is
# already ₪1 by Tranzila convention so it's unaffected. Pair with
# VITE_BILLING_TEST_MODE on the frontend to show ₪1 prices in the UI
# + a TEST MODE banner. Boot logs emit a WARN line when this is on
# so a misconfigured prod deploy is loud.
BILLING_TEST_MODE=false
